server {
    listen 6001;
    listen [::]:6001;

    # 换成你的域名；没有域名先用服务器 IP 或 _
    server_name _;

    root /var/www/bee;
    index index.html;

    # 静态资源缓存（可选，但推荐）
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # vue-router history 模式核心：找不到文件时回退到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}